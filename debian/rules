#!/usr/bin/make -f

STAGING := $(CURDIR)/debian/staging
STAGING_LIB := $(STAGING)/usr/lib/x86_64-linux-gnu
STAGING_PKGCONFIG := $(STAGING_LIB)/pkgconfig:$(STAGING)/usr/lib/pkgconfig
STAGING_FLAGS := -I$(STAGING)/usr/include -L$(STAGING_LIB) -L$(STAGING)/usr/lib

%:
	dh $@

override_dh_auto_configure:
	# Build libyang (install to staging via DESTDIR)
	cd src/libyang && mkdir -p build && cd build && \
		cmake -DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_INSTALL_PREFIX=/usr .. && \
		make -j$$(nproc) && \
		make install DESTDIR=$(STAGING)
	# Build sysrepo (find libyang from staging)
	cd src/sysrepo && mkdir -p build && cd build && \
		PKG_CONFIG_PATH=$(STAGING_PKGCONFIG) \
		cmake -DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_INSTALL_PREFIX=/usr \
			-DCMAKE_PREFIX_PATH=$(STAGING)/usr \
			-DCMAKE_C_FLAGS="$(STAGING_FLAGS)" \
			-DNOTIFD_SETUP=OFF -DENABLE_SYSREPO_NOTIFD=OFF \
			-DREPOSITORY_PATH=$(STAGING)/etc/sysrepo .. && \
		make -j$$(nproc) && \
		make install DESTDIR=$(STAGING)
	# Build libyang-cpp
	cd src/libyang-cpp && mkdir -p build && cd build && \
		cmake -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF \
			-DCMAKE_PREFIX_PATH=$(STAGING)/usr \
			-DCMAKE_CXX_FLAGS="$(STAGING_FLAGS)" \
			-DLIBYANG_LIBRARY=$(STAGING_LIB)/libyang.so \
			-DLIBYANG_INCLUDE_DIR=$(STAGING)/usr/include .. && \
		make -j$$(nproc) && \
		make install DESTDIR=$(STAGING)
	# Build sysrepo-cpp
	cd src/sysrepo-cpp && mkdir -p build && cd build && \
		PKG_CONFIG_PATH=$(STAGING_PKGCONFIG) \
		LD_LIBRARY_PATH=$(STAGING_LIB):$(STAGING)/usr/lib \
		cmake -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF -DWITH_EXAMPLES=OFF \
			-DCMAKE_PREFIX_PATH=$(STAGING)/usr \
			-DCMAKE_CXX_FLAGS="$(STAGING_FLAGS)" \
			-DCMAKE_SKIP_RPATH=OFF \
			-DCMAKE_INSTALL_RPATH=$(STAGING_LIB) \
			-DCMAKE_BUILD_RPATH=$(STAGING_LIB) .. && \
		LD_LIBRARY_PATH=$(STAGING_LIB):$(STAGING)/usr/lib \
		make -j$$(nproc) && \
		make install DESTDIR=$(STAGING)
	# Build umgmt (uthash headers are in deps/uthash/src not include)
	cd src/umgmt && mkdir -p build && cd build && \
		cmake -DCMAKE_INSTALL_PREFIX=/usr \
			-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
			-DCMAKE_C_FLAGS="-I$(CURDIR)/src/umgmt/deps/uthash/src" .. && \
		make -j$$(nproc) && \
		make install DESTDIR=$(STAGING)
	# Build sysrepo-plugins
	cd src/sysrepo-plugins && mkdir -p build && cd build && \
		PKG_CONFIG_PATH=$(STAGING_PKGCONFIG) \
		LD_LIBRARY_PATH=$(STAGING_LIB):$(STAGING)/usr/lib \
		cmake -DSYSTEMD_IFINDEX=1 -DBUILD_OS_METRICS_PLUGIN=OFF \
			-DCMAKE_PREFIX_PATH=$(STAGING)/usr \
			-DCMAKE_C_FLAGS="$(STAGING_FLAGS)" \
			-DCMAKE_CXX_FLAGS="$(STAGING_FLAGS)" \
			-DCMAKE_SKIP_RPATH=OFF \
			-DCMAKE_INSTALL_RPATH=$(STAGING_LIB) \
			-DCMAKE_BUILD_RPATH=$(STAGING_LIB) .. && \
		LD_LIBRARY_PATH=$(STAGING_LIB):$(STAGING)/usr/lib \
		make -j$$(nproc)

override_dh_auto_build:
	# Build Go binary against staging libs (using host Go module cache via mount)
	GOMODCACHE=/mnt/go-cache/pkg/mod GOPROXY=off \
	PKG_CONFIG_PATH=$(STAGING_PKGCONFIG) \
	CGO_CFLAGS="-I$(STAGING)/usr/include" \
	CGO_LDFLAGS="-L$(STAGING_LIB) -L$(STAGING)/usr/lib -lsysrepo -lyang" \
	go build -tags sysrepo -o confd ./cmd/confd

override_dh_auto_test:
	# Run Go tests (without sysrepo tag — mock adapter)
	go test -count=1 ./... -timeout 15s || true

override_dh_auto_install:
	# Install confd binary
	install -D confd $(CURDIR)/debian/confd/usr/bin/confd
	# Install sysrepo tools from staging
	for bin in sysrepoctl sysrepocfg yanglint yangre; do \
		install -D $(STAGING)/usr/bin/$$bin \
			$(CURDIR)/debian/confd/usr/bin/$$bin 2>/dev/null || true; \
	done
	# Install shared libraries from staging
	mkdir -p $(CURDIR)/debian/confd/usr/lib
	cp $(STAGING)/usr/lib/x86_64-linux-gnu/libyang.so* $(CURDIR)/debian/confd/usr/lib/ 2>/dev/null || true
	cp $(STAGING)/usr/lib/x86_64-linux-gnu/libsysrepo.so* $(CURDIR)/debian/confd/usr/lib/ 2>/dev/null || true
	cp $(STAGING)/usr/lib/x86_64-linux-gnu/libyang-cpp.so* $(CURDIR)/debian/confd/usr/lib/ 2>/dev/null || true
	cp $(STAGING)/usr/lib/x86_64-linux-gnu/libsysrepo-cpp.so* $(CURDIR)/debian/confd/usr/lib/ 2>/dev/null || true
	cp $(STAGING)/usr/lib/libumgmt.so* $(CURDIR)/debian/confd/usr/lib/ 2>/dev/null || true
	# Install YANG module directories (libyang + sysrepo internal modules)
	mkdir -p $(CURDIR)/debian/confd/usr/share
	cp -a $(STAGING)/usr/share/yang $(CURDIR)/debian/confd/usr/share/yang
	# Install sysrepo data directory
	mkdir -p $(CURDIR)/debian/confd/etc
	cp -a $(STAGING)/etc/sysrepo $(CURDIR)/debian/confd/etc/sysrepo
	# Install config
	mkdir -p $(CURDIR)/debian/confd/etc/confd
	cp confd.yaml $(CURDIR)/debian/confd/etc/confd/confd.yaml
	# Install plugins
	mkdir -p $(CURDIR)/debian/confd/usr/lib/confd/plugins
	cp src/sysrepo-plugins/build/plugins/*/libsrplg-*.so \
		$(CURDIR)/debian/confd/usr/lib/confd/plugins/ 2>/dev/null || true
	# Install YANG files from plugins
	for d in src/sysrepo-plugins/plugins/*/yang; do \
		plugin=$$(basename $$(dirname $$d)); \
		target=$(CURDIR)/debian/confd/usr/lib/confd/yang/$$plugin; \
		mkdir -p $$target; \
		cp $$d/*.yang $$target/ 2>/dev/null || true; \
	done
	# Install systemd service
	install -D debian/confd.service \
		$(CURDIR)/debian/confd/lib/systemd/system/confd.service

override_dh_install:
	# Skip dh_install — files installed in override_dh_auto_install

override_dh_dwz:
	# Skip dwz — Go binaries have compressed debug info

override_dh_installsystemd:
	# Skip — service file installed in override_dh_auto_install

override_dh_installinit:
	# Skip — service file installed in override_dh_auto_install

override_dh_shlibdeps:
	# Skip shlibdeps — bundled libs from staging, not system packages

override_dh_auto_clean:
	dh_auto_clean
	rm -rf src/libyang/build src/sysrepo/build src/libyang-cpp/build \
		src/sysrepo-cpp/build src/umgmt/build src/sysrepo-plugins/build
	rm -rf debian/staging
	rm -f confd